{
  "name": "oyun-uhaanii-academy",
  "version": "1.0.0",
  "description": "Oyun Uhaanii Academy - Full Stack Web Application",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run backend\" \"npm run frontend\"",
    "backend": "cd back-end && npm run dev",
    "frontend": "cd front-end && npm run dev",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "cd back-end && npm run build",
    "build:frontend": "cd front-end && npm run build",
    "start": "cd back-end && npm start",
    "install:all": "npm install && cd back-end && npm install && cd ../front-end && npm install",
    "prisma:generate": "cd back-end && npm run prisma:generate",
    "prisma:migrate": "cd back-end && npm run prisma:migrate",
    "prisma:push": "cd back-end && npm run prisma:push",
    "prisma:studio": "cd back-end && npm run prisma:studio",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "cd back-end && npm test",
    "test:frontend": "cd front-end && npm test",
    "test:coverage": "npm run test:backend:coverage && npm run test:frontend:coverage",
    "test:backend:coverage": "cd back-end && npm run test:coverage",
    "test:frontend:coverage": "cd front-end && npm run test:coverage",
    "lint": "npm run lint:backend && npm run lint:frontend",
    "lint:backend": "cd back-end && npm run lint",
    "lint:frontend": "cd front-end && npm run lint",
    "type-check": "npm run type-check:backend && npm run type-check:frontend",
    "type-check:backend": "cd back-end && npx tsc --noEmit",
    "type-check:frontend": "cd front-end && npx tsc --noEmit",
    "predeploy": "npm run install:all && npm run build && npm run test"
  },
  "keywords": [
    "academy",
    "gaming",
    "education",
    "fullstack",
    "nextjs",
    "express",
    "prisma"
  ],
  "author": "Oyun Uhaanii Academy",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.35.1",
    "@typescript-eslint/parser": "^8.35.1",
    "concurrently": "^8.2.2",
    "eslint": "^9.30.1",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.3.0",
    "ts-jest": "^29.4.0",
    "typescript": "^5.8.3"
  }
}
